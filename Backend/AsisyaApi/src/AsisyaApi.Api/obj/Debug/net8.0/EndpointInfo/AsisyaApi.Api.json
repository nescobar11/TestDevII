  "components": {
    "schemas": {
      "BulkCreateProductDto": {
        "required": [
          "categoryIds"
        ],
        "type": "object",
        "properties": {
          "quantity": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "categoryIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "batchSize": {
            "maximum": 10000,
            "minimum": 100,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateCategoryDto": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "picture": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateProductDto": {
        "required": [
          "productName"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "categoryId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantityPerUnit": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "unitPrice": {
            "maximum": 999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "unitsInStock": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "unitsOnOrder": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "reorderLevel": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "discontinued": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateProductDto": {
        "required": [
          "productName"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "categoryId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantityPerUnit": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "unitPrice": {
            "maximum": 999999999,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "unitsInStock": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "unitsOnOrder": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "reorderLevel": {
            "maximum": 32767,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "discontinued": {
            "type": "boolean"
          }
